:{$PORT:8080}

root * dist/web/browser
encode gzip zstd

# Cache: assets con hash (Angular outputHashing: all) -> inmutable un anio.
@hashedAsset path *.js *.css *.woff *.woff2 *.svg *.png *.jpg *.jpeg *.gif *.webp *.avif *.ico
header @hashedAsset Cache-Control "public, max-age=31536000, immutable"

# Cache: index.html y rutas SPA -> nunca cachear, deben revalidar siempre
# porque apuntan a chunks con hash que cambian con cada deploy.
@spa {
	not path *.js *.css *.map *.json *.woff *.woff2 *.ttf *.eot *.svg *.ico *.png *.jpg *.jpeg *.gif *.webp *.avif *.txt
}
header @spa Cache-Control "no-cache, no-store, must-revalidate"
header @spa Pragma "no-cache"

# Bloque route: respeta el orden literal y evita que try_files se aplique
# antes de devolver 404 a un asset estatico inexistente.
route {
	@missingAsset {
		path *.js *.css *.map *.json *.woff *.woff2 *.ttf *.eot *.svg *.ico *.png *.jpg *.jpeg *.gif *.webp *.avif *.txt
		not file
	}
	# 404 explicito para chunks que ya no existen tras un deploy. Antes
	# Caddy servia index.html con content-type text/html, lo que rompia
	# el bloqueo de MIME estricto del navegador para modulos JS y dejaba
	# el lazy load colgado (sintoma: login se queda "Ingresando...").
	respond @missingAsset 404

	# Fallback SPA solo para rutas Angular sin extension (deep links).
	try_files {path} /index.html

	file_server
}
